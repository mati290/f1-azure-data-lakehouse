
{
  "name": "job_f1_lakehouse",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "validate_bronze",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "<WORKSPACE_NOTEBOOK_ROOT>/01_bronze_validation",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "bronze_to_silver",
      "depends_on": [
        {
          "task_key": "validate_bronze"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "<WORKSPACE_NOTEBOOK_ROOT>/02_bronze_to_silver",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "silver_to_gold",
      "depends_on": [
        {
          "task_key": "bronze_to_silver"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "<WORKSPACE_NOTEBOOK_ROOT>/03_silver_to_gold",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "deploy_analytics",
      "depends_on": [
        {
          "task_key": "silver_to_gold"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "<WORKSPACE_NOTEBOOK_ROOT>/04_sql_business_analytics",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    }
  ],
  "format": "MULTI_TASK",
  "queue": {
    "enabled": true
  },
  "performance_target": "PERFORMANCE_OPTIMIZED"
}
